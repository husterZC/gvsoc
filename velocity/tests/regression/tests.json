{
  "smoke": [
    "read_after_write",
    "injection_rate",
    "zero_load_latency",
    "two_sided_test",
    "multi_chip_rdma",
    "software_collective_tree",
    "hardware_collective_innetwork",
    "max_bandwidth_4B"
  ],
  "full": [
    "read_after_write",
    "injection_rate",
    "zero_load_latency",
    "two_sided_test",
    "multi_chip_rdma",
    "software_collective_tree",
    "hardware_collective_innetwork",
    "max_bandwidth_4B",
    "max_bandwidth_64B",
    "max_bandwidth_4096B"
  ],
  "debug": [
    "max_bandwidth_4096B"
  ],
  "tests": {
    "read_after_write": {
      "suite": "topology_agnostic_tests/read_after_write",
      "app": "velocity/tests/topology_agnostic_tests/read_after_write/sw",
      "pass_regex": "READ_AFTER_WRITE_RESULT PASS",
      "comment": "All clusters write to all other clusters, then validate the received data."
    },
    "injection_rate": {
      "suite": "topology_agnostic_tests/injection_rate",
      "app": "velocity/tests/topology_agnostic_tests/injection_rate/sw",
      "pass_regex": "INJECTION_RATE_RESULT PASS",
      "comment": "All-to-all traffic with an injection-gap control point."
    },
    "zero_load_latency": {
      "suite": "topology_agnostic_tests/zero_load_latency",
      "app": "velocity/tests/topology_agnostic_tests/zero_load_latency/sw",
      "pass_regex": "ZERO_LOAD_LATENCY_RESULT PASS",
      "comment": "One probe from cluster 0 to every other active cluster."
    },
    "two_sided_test": {
      "suite": "topology_agnostic_tests/two_sided_test",
      "app": "velocity/tests/topology_agnostic_tests/two_sided_test/sw",
      "pass_regex": "TWO_SIDED_RESULT PASS",
      "comment": "Native blocking send, recv, and sendrecv between cluster 0 and cluster n-1."
    },
    "multi_chip_rdma": {
      "suite": "topology_agnostic_tests/multi_chip_rdma",
      "app": "velocity/tests/topology_agnostic_tests/multi_chip_rdma/sw",
      "pass_regex": "MULTI_CHIP_RDMA_RESULT PASS",
      "topologies": [
        "multi_chip_ring_N2_C4"
      ],
      "comment": "Cluster 0 on chip 0 verifies one-sided RDMA write/read through the off-chip unified interconnect."
    },
    "software_collective_tree": {
      "suite": "topology_agnostic_tests/software_collective_tree",
      "app": "velocity/tests/topology_agnostic_tests/software_collective_tree/sw",
      "pass_regex": "SOFTWARE_COLLECTIVE_TREE_RESULT PASS",
      "cmake_defs": {
        "SOFTWARE_COLLECTIVE_TREE_TEST_MAX_ALL_GROUP": 16,
        "SOFTWARE_COLLECTIVE_TREE_TEST_MAX_SUBSET_GROUP": 8
      },
      "comment": "Tree-based logical collectives over native two-sided DMA."
    },
    "hardware_collective_innetwork": {
      "suite": "topology_agnostic_tests/hardware_collective_innetwork",
      "app": "velocity/tests/topology_agnostic_tests/hardware_collective_innetwork/sw",
      "pass_regex": "HARDWARE_COLLECTIVE_INNETWORK_RESULT PASS",
      "cmake_defs": {
        "HARDWARE_COLLECTIVE_INNETWORK_TEST_MAX_EXHAUSTIVE_GROUP": 16,
        "HARDWARE_COLLECTIVE_INNETWORK_TEST_MAX_PATTERN_GROUP": 16
      },
      "comment": "Topology-agnostic in-router broadcast, reduce, scatter, gather, and all-to-all collectives."
    },
    "max_bandwidth_4B": {
      "suite": "topology_agnostic_tests/max_bandwidth",
      "app": "velocity/tests/topology_agnostic_tests/max_bandwidth/sw",
      "pass_regex": "MAX_BANDWIDTH_RESULT PASS",
      "cmake_defs": {
        "MAX_BANDWIDTH_TEST_TXN_SIZE": 4,
        "MAX_BANDWIDTH_TEST_REPEAT": 4,
        "MAX_BANDWIDTH_TEST_MAX_INFLIGHT": 2,
        "MAX_BANDWIDTH_TEST_SLOTS": 2
      },
      "comment": "Small one-way bandwidth transfer."
    },
    "max_bandwidth_64B": {
      "suite": "topology_agnostic_tests/max_bandwidth",
      "app": "velocity/tests/topology_agnostic_tests/max_bandwidth/sw",
      "pass_regex": "MAX_BANDWIDTH_RESULT PASS",
      "cmake_defs": {
        "MAX_BANDWIDTH_TEST_TXN_SIZE": 64,
        "MAX_BANDWIDTH_TEST_REPEAT": 8,
        "MAX_BANDWIDTH_TEST_MAX_INFLIGHT": 4,
        "MAX_BANDWIDTH_TEST_SLOTS": 4
      },
      "comment": "Larger one-way bandwidth transfer."
    },
    "max_bandwidth_4096B": {
      "suite": "topology_agnostic_tests/max_bandwidth",
      "app": "velocity/tests/topology_agnostic_tests/max_bandwidth/sw",
      "pass_regex": "MAX_BANDWIDTH_RESULT PASS",
      "cmake_defs": {
        "MAX_BANDWIDTH_TEST_TXN_SIZE": 4096,
        "MAX_BANDWIDTH_TEST_REPEAT": 128,
        "MAX_BANDWIDTH_TEST_MAX_INFLIGHT": 8,
        "MAX_BANDWIDTH_TEST_SLOTS": 8
      },
      "comment": "Debug one-way bandwidth transfer with 4096-byte DMA transactions."
    }
  }
}
